# Discord Developer Portal values. Never commit the token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_COMMAND_SCOPE=guild
DISCORD_ENABLE_MESSAGE_CONTENT=true

# The app works with AI_MODE=mock and no OpenAI key.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000

LIVE_CHAT_MAX_HISTORY=20
LIVE_CHAT_COOLDOWN_MS=1000
LIVE_CHAT_SHOW_DIAGNOSTICS=true

DATABASE_PATH=./data/projects.json
ARTIFACT_DIR=./data/artifacts
MAX_PACKAGE_BYTES=20971520
TIME_ZONE=Asia/Seoul
