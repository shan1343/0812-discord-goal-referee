{
  "name": "discord-goal-referee-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/package-sites.mjs",
    "start": "next start -p 3000",
    "dev:web": "next dev -p 3000",
    "build:web": "next build",
    "start:web": "next start -p 3000",
    "start:bot": "npm --prefix discord-bot start",
    "register:bot": "npm --prefix discord-bot run register",
    "test:bot": "npm --prefix discord-bot test",
    "test:legacy-bot": "npm --prefix discord-progress-bot test",
    "test:discord": "npm --prefix discord-bot test",
    "test:api": ".venv\\Scripts\\python.exe -m pytest -q",
    "qa": "node qa/validate_goldset.mjs && node qa/validate_fixture_bindings.mjs",
    "check": "npm run test:api && npm run test:bot && npm run test:legacy-bot && npm run qa && pnpm build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
